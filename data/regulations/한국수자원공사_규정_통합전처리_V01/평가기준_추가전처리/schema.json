        {
          "n": "parent_item_id",
          "t": "VARCHAR(64)",
          "nn": false,
          "pk": false,
          "c": "선택 FK  같은 양식의 상위 항목. 자기 참조"
        },
        {
          "n": "skill_id",
          "t": "INT",
          "nn": false,
          "pk": false,
          "c": "ERD 기존 선택 연결 → skill_tags.skill_id. 규정 항목과 스킬의 대응이 확인될 때만 연결"
        },
        {
          "n": "item_code",
          "t": "VARCHAR(255)",
          "nn": true,
          "pk": false,
          "c": "양식 내 항목 코드. 양식별 중복 방지"
        },
        {
          "n": "item_name",
          "t": "VARCHAR(255)",
          "nn": true,
          "pk": false,
          "c": "원문 항목 이름"
        },
        {
          "n": "value_kind",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "값 종류. score, grade, hours, course_count, group 제안"
        },
        {
          "n": "aggregation_role",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "group 또는 leaf. 상위 집계와 하위 항목을 중복 합산하지 않음"
        },
        {
          "n": "score_min",
          "t": "NUMERIC(12,3)",
          "nn": false,
          "pk": false,
          "c": "원문에서 확인된 점수 하한. 미확인은 NULL"
        },
        {
          "n": "score_max",
          "t": "NUMERIC(12,3)",
          "nn": false,
          "pk": false,
          "c": "원문에서 확인된 배점·상한. 미확인은 NULL"
        },
        {
          "n": "weight_percent",
          "t": "NUMERIC(6,3)",
          "nn": false,
          "pk": false,
          "c": "원문 비율을 퍼센트로 기록. 배점과 혼동하지 않음"
        },
        {
          "n": "unit",
          "t": "VARCHAR(40)",
          "nn": false,
          "pk": false,
          "c": "점·퍼센트·시간·과정 수 등 원문 단위"
        },
        {
          "n": "scale_note",
          "t": "TEXT",
          "nn": false,
          "pk": false,
          "c": "ERD 기존 척도·등급·단위 설명 유지. unit은 구조화 단위로 함께 사용"
        },
        {
          "n": "display_order",
          "t": "INT",
          "nn": true,
          "pk": false,
          "c": "양식 안의 표시 순서"
        },
        {
          "n": "definition_note",
          "t": "TEXT",
          "nn": false,
          "pk": false,
          "c": "평정 방식·제외·산식 적용 설명"
        }
      ]
    },
    "evaluation_schema_source": {
      "cols": [
        {
          "n": "evaluation_schema_source_id",
