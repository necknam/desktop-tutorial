{
  "contract_version": "K-water evaluation criteria V01",
  "status": "draft_needs_human_review",
  "tables": {
    "evaluation_result_schema": {
      "cols": [
        {
          "n": "evaluation_result_schema_id",
          "t": "VARCHAR(64)",
          "nn": true,
          "pk": true,
          "c": "PK  평가 기준·양식 ID"
        },
        {
          "n": "institution_id",
          "t": "VARCHAR(64)",
          "nn": true,
          "pk": false,
          "c": "FK  기관 ID → institution"
        },
        {
          "n": "schema_name",
          "t": "VARCHAR(255)",
          "nn": true,
          "pk": false,
          "c": "평가 기준·양식 이름"
        },
        {
          "n": "version_label",
          "t": "VARCHAR(255)",
          "nn": true,
          "pk": false,
          "c": "기준 버전 표시. 규정 개정과 별도로 식별"
        },
        {
          "n": "evaluation_kind",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "평가 종류. 종합근무·근무성적·경력·교육훈련·가감평정 등 원문 범위를 구분"
        },
        {
          "n": "applicability_condition",
          "t": "JSONB",
          "nn": true,
          "pk": false,
          "c": "직군·직렬·직급·직위 등 적용 조건. 현재 시연 대상과 원문 적용 범위를 구분"
        },
        {
          "n": "applicability_note",
          "t": "TEXT",
          "nn": false,
          "pk": false,
          "c": "ERD 기존 적용 설명 유지. 구조화 조건과 함께 사람이 읽을 설명 보관"
        },
        {
          "n": "effective_from",
          "t": "DATE",
          "nn": false,
          "pk": false,
          "c": "확인된 적용 시작일. 미확인은 NULL"
        },
        {
          "n": "effective_to",
          "t": "DATE",
          "nn": false,
          "pk": false,
          "c": "확인된 적용 종료일. 미확인은 NULL"
        },
        {
          "n": "rule_origin",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "기준의 성격. published_rule 또는 demo_rule 제안"
        },
        {
          "n": "source_status",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "근거 확보 상태. confirmed, partial, unknown 제안"
        },
        {
          "n": "review_status",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "검토 상태. needs_review, reviewed 제안; 사람 검토 후 확정"
        },
        {
          "n": "calculation_rule",
          "t": "JSONB",
          "nn": false,
          "pk": false,
          "c": "확인된 산식·변수·단위·처리 규칙과 기준학습시간·필수과정 조건. 미확인은 값과 상태를 구분"
        },
        {
          "n": "calculation_status",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "산식 상태. known_formula, partial, unspecified 제안"
        },
        {
          "n": "source_note",
          "t": "TEXT",
          "nn": false,
          "pk": false,
          "c": "기관 세부 기준의 미확인 사항과 적용 한계"
        }
      ]
    },
    "evaluation_item_definition": {
      "cols": [
        {
          "n": "evaluation_item_definition_id",
          "t": "VARCHAR(64)",
          "nn": true,
          "pk": true,
          "c": "PK  평가 항목 ID"
