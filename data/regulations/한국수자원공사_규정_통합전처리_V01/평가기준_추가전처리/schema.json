          "nn": false,
          "pk": false,
          "c": "선택 FK  같은 양식의 항목. NULL이면 양식 전체 근거"
        },
        {
          "n": "regulation_node_id",
          "t": "VARCHAR(64)",
          "nn": true,
          "pk": false,
          "c": "FK  기존 원문 항목 ID → regulation_node"
        },
        {
          "n": "source_role",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "basis, form, weight, formula, precision, exception 등 근거 역할 제안"
        },
        {
          "n": "review_status",
          "t": "VARCHAR(40)",
          "nn": true,
          "pk": false,
          "c": "근거 연결 검토 상태. needs_review, reviewed 제안"
        },
        {
          "n": "source_note",
          "t": "TEXT",
          "nn": false,
          "pk": false,
          "c": "확인한 표·조항 범위와 미확인 부분"
