        "minimum_continuous_service_years": 3,
        "initial_excluded_service_years": 1,
        "additional_leave_per_service_years": 2,
        "additional_leave_days": 1,
        "total_leave_day_cap": 25,
        "base_leave_reference": "제1항"
      },
