  "interpretation_guidance": {
    "handling_review_status": "quota_and_actual_headcount_distinction_confirmed",
    "accepted_handling": "정원표에 따른 정원과 실제 재직 인원인 현원을 구분하여 안내.",
    "user_review": {
      "reviewed_at": "2026-10-13",
      "answer": "정원표에 따른 정원과 실제 인원(현원)을 구분해서 안내하는 권장안을 사용하는 것에 동의.",
      "confirmed_scope": "정원과 현원의 구분",
      "numeric_transcription_confirmed_by_user": false,
      "institutional_interpretation_confirmed_by_user": false
    },
    "source_structure_handling": "3～5급·6～8급은 원문의 묶음 직급으로 보존. 개별 직급 수치는 이 표에 제시되어 있지 않아 임의 분배하지 않음.",
    "operational_question_handling": "실제 직급별 운영 인원과 정원 초과 여부는 별도 인사자료와 제7조 등 운영 기준을 확인한 뒤 판단.",
    "actual_staff_count_source": null,
    "automated_decision_enabled": false
  },
  "related_provisions": [
    {
      "regulation_node_id": "6ac269d3-2354-5c61-9c34-43ee76f740dc",
      "label": "제7조",
      "body_text": "제7조(정원) ① 공사의 정원은 별표 2와 같으며, 정원 범위 내에서 1년 이상의 교육파견, 휴직, 대\n외기관파견 등을 운용할 수 있다. 다만, 정부와 협의하여 반영된 수탁사업종사직원, 임금피크제\n직원의 정원은 직제규정 시행세칙으로 정한다. <개정 2017.06.27, 2019.06.25, 2023.12.04>\n② 직급별 정원 범위에서 복수보임 직위에 필요한 2급 정원을 갑과 을로 구분 운영할 수 있으며,\n관리체계는 시행세칙으로 정한다.\n③ 제1항에도 불구하고 필요한 경우 총 정원 범위에서 3~5급·전문직간, 6~8급·운영직·특정직간\n정원을 통합하여 운영할 수 있다. < 신설 2012.06.26 >",
      "source_locator": {
