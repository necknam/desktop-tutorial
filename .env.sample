# ==============================================================================
# 1. 공공데이터포털 API 인증키 (data.go.kr - 승인 완료)
# ==============================================================================
# K-MOOC v2.0, K-DATA 데이터 자격검정, 대학알리미 학과정보 공통 일반 인증키
DATA_GO_KR_API_KEY=a5c44e9278e37644130b7b7dd50411d6783c544bf6d1995fa00cec8bbe5bb4a1
KMOOC_SERVICE_KEY=a5c44e9278e37644130b7b7dd50411d6783c544bf6d1995fa00cec8bbe5bb4a1

# ==============================================================================
# 2. 미승인 / 승인 대기 외부 공공 API 키 (Not Yet Approved)
# ==============================================================================
# not yet - 도서관 정보나루 Open API 키 (발급 전까지 DB 기존 도서 데이터 영구 보존)
LIBRARY_AUTH_KEY=
LIBRARY_NARU_API_KEY=

# not yet - 커리어넷 Open API 키 (발급 전까지 DB 기존 직무/학과 데이터 영구 보존)
CAREERNET_API_KEY=

# ==============================================================================
# 3. Supabase PostgreSQL 연결 URI
# ==============================================================================
# Supabase 대시보드 -> Project Settings -> Database -> Connection string -> URI
# 기본 포트(Direct Connection): 5432 / Pooler(Session Mode): 5432 / Transaction: 6543
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ==============================================================================
# 4. Supabase REST API 접속 정보 (클라이언트 SDK 사용 시)
# ==============================================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ==============================================================================
# 5. OpenAI API 키 (RoadmapAgent 로드맵 생성용)
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o